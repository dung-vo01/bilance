ENVIRONMENT=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bilance_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bilance_test
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
GUEST_ACCOUNT_TTL_HOURS=24
# memory:// (default, single instance) or redis://localhost:6379 (docker compose up -d redis)
RATE_LIMIT_STORAGE_URI=memory://
# Shared secret for /api/internal/* (scheduled jobs). Empty disables those routes.
INTERNAL_API_SECRET=
AWS_REGION=eu-north-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_ACCESS_KEY=
# True: send email via SES (verification, password reset, notices).
# False: signups are auto-verified and logged in; no password reset.
EMAIL_ENABLED=False